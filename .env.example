APP_URL=http://127.0.0.1:3014
# Local demo only. Production rejects demo identities and local storage.
CRM_DEMO_MODE=true
# DATABASE_URL=postgresql://user:password@host:5432/crm
# Separate DDL credentials: keep local/CI only, never in the deployed app.
# DATABASE_MIGRATION_URL=postgresql://migration-user:password@host:5432/crm
# Remote PostgreSQL always verifies TLS. Supply the provider's CA when required.
DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# For local development PostgreSQL only, DATABASE_SSL_MODE=disable is supported.
# BETTER_AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Passwordless email codes require both a server-side key and a verified sender.
# RESEND_API_KEY=
# EMAIL_FROM="Gravity <login@example.com>"
# Provider credentials are encrypted with a persistent 32-byte hexadecimal key.
# INTEGRATION_ENCRYPTION_KEY=generate-64-hex-characters
# Scheduled sync: private Bearer credential, also used by Vercel Cron.
# CRON_SECRET=generate-at-least-32-random-characters
# Google integration OAuth can use the login client with a SEPARATE callback:
# <APP_URL>/api/integrations/callback/google
# Optional dedicated client overrides:
# GOOGLE_INTEGRATION_CLIENT_ID=
# GOOGLE_INTEGRATION_CLIENT_SECRET=
# LinkedIn requires a Unipile V2 application and signed webhook endpoint.
# UNIPILE_API_KEY=
# UNIPILE_WEBHOOK_SECRET=
# Fireflies API keys are entered by each account owner in Connections, not an env var.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional public marketing origin. Never use the existing Twenty domain without migration review.
# PUBLIC_SITE_URL=https://gravity.example.com
# Index only public pages after production launch. Preview deployments always remain noindex.
PUBLIC_SITE_INDEXING=false
