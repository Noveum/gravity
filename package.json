{
  "name": "@noveum/gravity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3014",
    "build": "next build",
    "start": "next start --port 3014",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "better-auth": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/cimd": "1.7.7",
    "@modelcontextprotocol/server": "2.3.0",
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "zod": "4.6.5",
    "lucide-react": "1.51.0",
    "@aws-sdk/client-s3": "3.1146.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "tsx": "4.23.15",
    "drizzle-kit": "0.31.9"
  }
}
