{
  "name": "@noveum/gravity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3014",
    "build": "next build",
    "start": "next start --port 3014",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:seed": "tsx scripts/seed.ts",
    "licenses": "tsx scripts/licenses.ts",
    "licenses:check": "tsx scripts/licenses.ts --check",
    "test:public": "tsx scripts/smoke-public-site.ts",
    "test:deployment": "tsx scripts/smoke-deployment.ts",
    "brand:generate": "tsx scripts/brand-assets.ts",
    "verify": "bun run lint && bun run licenses:check && bun run typecheck && bun run test && bun run build && bun run test:public",
    "test:files": "playwright test --config playwright.files.config.ts",
    "test:file-storage": "tsx scripts/test-file-storage.ts"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/server": "2.3.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slider": "1.5.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-virtual": "3.14.9",
    "better-auth": "1.7.7",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.16",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "pdfjs-dist": "6.4.299",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.0",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Noveum/gravity.git"
  },
  "homepage": "https://gravity.noveum.ai",
  "bugs": {
    "url": "https://github.com/Noveum/gravity/issues"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "uuid": "11.1.1"
  }
}
