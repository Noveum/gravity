{
  "name": "@noveum/gravity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3014",
    "build": "next build",
    "start": "next start --port 3014",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:seed": "tsx scripts/seed.ts",
    "licenses": "tsx scripts/licenses.ts",
    "licenses:check": "tsx scripts/licenses.ts --check",
    "test:public": "tsx scripts/smoke-public-site.ts",
    "test:deployment": "tsx scripts/smoke-deployment.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "better-auth": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/cimd": "1.7.7",
    "@modelcontextprotocol/server": "2.3.0",
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "zod": "4.6.5",
    "lucide-react": "1.51.0",
    "@aws-sdk/client-s3": "3.1146.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.9",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Noveum/gravity.git"
  },
  "homepage": "https://github.com/Noveum/gravity#readme",
  "bugs": {
    "url": "https://github.com/Noveum/gravity/issues"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
