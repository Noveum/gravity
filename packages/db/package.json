{
  "name": "@gravity/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./test-lane": "./src/test-lane.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "bun --env-file=../../.env src/ensure-extensions.ts && bun --env-file=../../.env drizzle-kit migrate",
    "push": "bun --env-file=../../.env src/ensure-extensions.ts && bun --env-file=../../.env drizzle-kit push --force",
    "studio": "bun --env-file=../../.env drizzle-kit studio",
    "test": "bun --env-file=../../.env test --timeout 20000 --max-concurrency 1",
    "test-setup": "bun --env-file=../../.env src/ensure-test-databases.ts"
  },
  "dependencies": {
    "@gravity/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "pg": "8.22.0",
    "typescript": "5.9.3"
  }
}
